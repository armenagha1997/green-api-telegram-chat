# GREEN-API instance credentials (console.green-api.com)
# Скопируй этот файл в .env.local и заполни реальными значениями.
# .env.local в .gitignore — не коммитить.

VITE_GREEN_API_ID_INSTANCE=
VITE_GREEN_API_TOKEN_INSTANCE=
# apiUrl у каждого инстанса свой хост (см. консоль, поле apiUrl)
VITE_GREEN_API_URL=
